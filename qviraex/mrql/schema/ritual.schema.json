{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirror.me/schemas/mrql/ritual.schema.json",
  "title": "MRQL Ritual",
  "type": "object",
  "required": ["name", "version", "metadata", "sequence"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "author", "signature_required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "author": {"type": "string", "minLength": 1},
        "signature_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["dimensions", "backend", "dtype"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "backend": {"type": "string"},
        "dtype": {"type": "string"}
      },
      "additionalProperties": true
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "arguments"],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}