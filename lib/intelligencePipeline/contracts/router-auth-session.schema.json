{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilisation.one/schemas/router-auth-session.schema.json",
  "title": "Global Intelligence Router Auth Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "member_public_id",
    "authenticator",
    "scopes",
    "issued_at_utc",
    "expires_at_utc",
    "audience"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 8
    },
    "member_public_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string"
    },
    "authenticator": {
      "type": "string",
      "enum": [
        "session_token",
        "wallet_signature",
        "did_signature",
        "device_key"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "route:chat",
          "route:scientific",
          "route:publication_candidate",
          "route:admin_ops"
        ]
      }
    },
    "issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "string",
      "const": "civilisation.one.global-intelligence-router"
    },
    "token_fingerprint": {
      "type": "string",
      "description": "Hash of session token material for audit correlation; never the raw token"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    }
  }
}
