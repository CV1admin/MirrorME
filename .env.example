# MirrorME local environment template
# Copy this file to .env.local for local development. Do not commit .env.local.

# Browser-visible Gemini key for local testing only. Vite exposes variables prefixed with VITE_ to client code.
VITE_GEMINI_API_KEY=

# Server-only OpenAI Platform key. Do not expose this in browser code.
# Use it only from a backend/API route or local trusted setup flow.
OPENAI_API_KEY=
